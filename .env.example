# Local development uses SQLite when no PostgreSQL URL is configured.
CHALLAN_NYAY_DB=data/challan-nyay.db

# Production: provide one managed PostgreSQL connection string.
# CHALLAN_NYAY_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
CHALLAN_NYAY_REQUIRE_POSTGRES=false
CHALLAN_NYAY_DB_POOL_MAX=5

# Replace demo fallbacks in every deployed environment.
CHALLAN_NYAY_CHALLENGE_SECRET=replace-with-a-long-random-secret
CHALLAN_NYAY_SESSION_SECRET=replace-with-a-different-long-random-secret

# Signed WhatsApp webhook and Meta Cloud API boundary.
# Use distinct values with at least 32 characters in every deployed environment.
CHALLAN_NYAY_WHATSAPP_APP_SECRET=replace-with-the-meta-app-secret
CHALLAN_NYAY_WHATSAPP_IDENTITY_SECRET=replace-with-a-sender-pseudonym-secret
CHALLAN_NYAY_WHATSAPP_HANDOFF_SECRET=replace-with-a-handoff-signing-secret
CHALLAN_NYAY_WHATSAPP_VERIFY_TOKEN=replace-with-a-webhook-verify-token
CHALLAN_NYAY_PUBLIC_WEB_URL=http://127.0.0.1:4173/
# Optional when Meta needs a public origin for synthetic evidence images.
# CHALLAN_NYAY_PUBLIC_ASSET_URL=https://your-public-api.example/

# Required only when live Meta delivery is enabled. Keep access tokens server-side.
# CHALLAN_NYAY_WHATSAPP_ACCESS_TOKEN=replace-with-a-system-user-or-temporary-test-token
# CHALLAN_NYAY_WHATSAPP_PHONE_NUMBER_ID=replace-with-the-cloud-api-phone-number-id
CHALLAN_NYAY_WHATSAPP_GRAPH_API_VERSION=v23.0
