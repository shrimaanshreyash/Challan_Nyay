{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && cd apps/web && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist/client",
  "rewrites": [
    {
      "source": "^/api/(.*)$",
      "destination": "/api/index?path=$1"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  }
}
