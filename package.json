{
  "name": "challan-nyay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run build --prefix apps/web",
    "db:migrate": "npm run migrate:postgres --prefix apps/api",
